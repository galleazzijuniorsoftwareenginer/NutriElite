# Copie este arquivo para ".env" (mesma pasta) e preencha os valores.
# docker compose lê ".env" automaticamente — nunca commitar o ".env" real (já está no .gitignore).

# Obrigatória: assina os tokens de sessão. O backend recusa iniciar sem ela.
# Gere uma com: openssl rand -hex 32
JWT_SECRET_KEY=

# Opcional, mas recomendada: senha do usuário "admin" auto-criado no seed.
# Sem isso, usa a senha pública padrão documentada no CLAUDE.md (nutrielite2024).
ADMIN_PASSWORD=

# Necessária para o gerador de menu com IA e extração de laboratório por foto.
ANTHROPIC_API_KEY=

# Necessárias apenas se for testar cobrança (Stripe).
STRIPE_API_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Necessária apenas para testar recuperação de senha por email.
RESEND_API_KEY=

# Opcional: sem isso, a planilha de micronutrientes se reporta como "não configurada".
USDA_FDC_API_KEY=

# Usada para montar links de checkout/reset de senha. Padrão local já funciona.
PUBLIC_BASE_URL=http://localhost:8000
